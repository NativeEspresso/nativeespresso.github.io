{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "AZURE_SQL_CONNECTION_STRING": "Server=tcp:native-espresso-sql.database.windows.net,1433;Initial Catalog=NativeEspressoDb;Persist Security Info=False;User ID=cloudadmin;Password=YourSecurePasswordHere!;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;",
    "BLOB_STORAGE_CONNECTION_STRING": "DefaultEndpointsProtocol=https;AccountName=nativeespressostorage;AccountKey=YourBlobKeyHere==;EndpointSuffix=core.windows.net",
    "RESEND_API_KEY": "re_123456789_YourResendApiKeyHere",
    "BREVO_API_KEY": "xkeysib-123456789_YourBrevoApiKeyHere",
    "ADMIN_API_KEY": "ChangeThisToASecretKeyForApprovingTesters",
    "SENDER_EMAIL": "native.espresso@gmail.com",
    "SENDER_NAME": "Native Espresso Studio"
  },
  "Host": {
    "CORS": "https://nativeespresso.github.io,http://localhost:3000,http://127.0.0.1:5500",
    "CORSCredentials": false
  }
}
